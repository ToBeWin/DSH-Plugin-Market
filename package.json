{
  "name": "@tobewin/dsh-plugin-market",
  "version": "0.1.1",
  "description": "Local-only installed plugin manager for DeepSeek Harness profiles",
  "license": "MIT",
  "author": "ToBeWin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ToBeWin/DSH-Plugin-Market.git"
  },
  "bugs": {
    "url": "https://github.com/ToBeWin/DSH-Plugin-Market/issues"
  },
  "homepage": "https://github.com/ToBeWin/DSH-Plugin-Market#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "plugin-manager"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": {
    "dsh-plugin-market": "lib/cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp client/client.js lib/client.js && rm -rf lib/public && cp -R public lib/public",
    "check": "tsc --noEmit",
    "prepack": "pnpm build",
    "start": "node lib/cli.js",
    "qa:capture": "../dsh-desktop/node_modules/.bin/electron script/capture-market.cjs",
    "qa:settings": "../dsh-desktop/node_modules/.bin/electron script/capture-settings-market.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
